/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Revalidate HTML so visitors receive current collection and ordering updates.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Asset filenames are not content-hashed, so use conservative browser caching
# and a longer shared-cache lifetime rather than immutable year-long caching.
/assets/*
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400

# The catalogue PDF can change without its URL changing; keep browser freshness short.
/*.pdf
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600
